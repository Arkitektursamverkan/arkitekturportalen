# Arkitekturportalen – generic nginx config (plain HTTP).
#
# A template: docker/30-ea-nginx.sh writes it to conf.d/default.conf when the
# container starts, filling in ${PORT} (default 80), ${API_UPSTREAM} (default
# api:8000) and ${NGINX_RESOLVER} (the container's own DNS). An installation
# that mounts its own conf.d/default.conf keeps it – the template is skipped.
#
# TLS is expected in front of this (a reverse proxy, load balancer or a
# platform such as Render), or in an installation's own overlay that mounts
# its own config and certificates.
#
# Security headers (CSP and others) come from security-headers.conf. Sign-in
# (POST under /api/v1/auth/) is limited to 10 a minute per client address,
# bursts of 5, then 429. Behind a proxy (Render, a load balancer) every request
# comes from the proxy's address – set TRUSTED_PROXY to its address or range
# (e.g. 10.0.0.0/8, several separated by spaces or commas) and the client's
# address is taken from X-Forwarded-For instead. Leave it unset when nginx
# faces the clients directly: the header could then be forged.
#
# The API gets only the one address nginx settled on ($remote_addr, after the
# real-ip step) in X-Forwarded-For – never the chain as the client sent it, so
# nothing behind nginx can be fooled by addresses a client wrote itself.

map $request_method $ea_login_limit_key {
    POST    $binary_remote_addr;
    default "";
}
limit_req_zone $ea_login_limit_key zone=ea_login:10m rate=10r/m;

server {
    listen ${PORT} default_server;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/ea/security-headers.conf;
${REAL_IP_CONFIG}
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # index.html is also MSAL's redirect bridge: Entra's sign-in response lands
    # here (auth/redirectBridge.ts), so the page must never be stored.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-store";
        include /etc/nginx/ea/security-headers.conf;
    }

    # The API's address is looked up again every 10 s, not once at start: on a
    # platform such as Render a redeployed API gets a new address, and nginx
    # would otherwise keep sending to the old one until it restarts.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    location /api {
        set $api_upstream http://${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Sign-in and the first administrator: a limit against password guessing.
    location /api/v1/auth/ {
        limit_req zone=ea_login burst=5 nodelay;
        limit_req_status 429;
        set $api_upstream http://${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Written at container start from the environment – never cache it, or a
    # changed setting would need every browser's cache cleared.
    location = /config.js {
        add_header Cache-Control "no-cache";
        include /etc/nginx/ea/security-headers.conf;
    }

    location ~* \.(js|css|png|svg|ico|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/ea/security-headers.conf;
    }

    location /locales/ {
        add_header Cache-Control "no-cache";
        include /etc/nginx/ea/security-headers.conf;
    }
}
