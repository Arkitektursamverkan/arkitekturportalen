# Arkitekturportalen – installation settings.
# Copy to .env and fill in. docker-compose.yml reads this file; nothing
# installation-specific is built into the images.

# ── Compose ───────────────────────────────────────────────────────────────────
# Add your own overlay for TLS, extra ports or a custom nginx config, e.g.
#   COMPOSE_FILE=docker-compose.yml:deploy/<org>/compose.<org>.yml
# COMPOSE_FILE=docker-compose.yml
# Integration Platform on the same server? Put both on a shared network
# (once: docker network create arkitekturportalen) and add
# deploy/integration-platform.yml, e.g.
#   COMPOSE_FILE=docker-compose.yml:deploy/integration-platform.yml
# Host port for the web UI (nginx, plain HTTP).
WEB_PORT=3000

# ── Environment ───────────────────────────────────────────────────────────────
# production (default in compose) | development | test.
# Anything but development/test refuses to start if API_KEY or
# LOCAL_AUTH_SECRET is empty, a placeholder or shorter than 32 characters.
APP_ENV=production
LOG_LEVEL=info

# ── Secrets ───────────────────────────────────────────────────────────────────
# Generate each with:  openssl rand -hex 32
# API_KEY acts as an admin – for scripts and integrations only, never the browser.
API_KEY=
# Signs the login tokens of local (non-Entra) accounts.
LOCAL_AUTH_SECRET=
LOCAL_TOKEN_TTL_HOURS=12
# Database password. Only read when the database volume is first created.
POSTGRES_PASSWORD=

# ── Database ──────────────────────────────────────────────────────────────────
# Engine: postgres (default) | neo4j (start with --profile neo4j)
EA_DB_ENGINE=postgres
NEO4J_PASSWORD=

# ── Sign-in: Microsoft Entra ID (optional) ────────────────────────────────────
# Leave empty to use local accounts only. The SPA app registration needs the
# redirect URI https://<your host>/ and an exposed API scope access_as_user.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Defaults to api://<ENTRA_CLIENT_ID>/access_as_user
ENTRA_API_SCOPE=
# Only these e-mail domains may sign in (comma-separated). Default for
# Administration → Organisation, which overrides it once set there.
ALLOWED_EMAIL_DOMAINS=example.org
# Signing in with one of these makes the account an administrator.
BOOTSTRAP_ADMIN_EMAILS=
# Let callers without credentials read the architecture objects (what the
# "everyone" access grants allow). Default for Administration → Organisation.
ANONYMOUS_READ=false

# ── Modules ───────────────────────────────────────────────────────────────────
# Optional parts of the app, comma-separated, or "all". Empty = the core only
# (architecture objects, views, reports, solution sketches, administration).
#   calendar       Verksamhetskalender with the change log
#   collaboration  Samarbeten: uppdrag and arbetsgrupper
#   governance     Arkitekturstyrning: principles, current state, target
#                  architecture, GAP analysis
#   glossary       Ordlista
#   surveys        Enkäter
# Default for Administration → Organisation, where an admin can switch
# modules on and off later.
MODULES=

# ── Web ───────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=https://arkitektur.example.org

# ── Organisation ──────────────────────────────────────────────────────────────
# CHANGE_LOG_DEPARTMENTS and PDF_ORG_NAME are defaults: an admin can set them,
# and the logo and brand colour, under Administration → Organisation.
# Departments (as Entra ID names them, comma-separated) whose people may write
# in the change log. Admins always may.
CHANGE_LOG_DEPARTMENTS=
# Default organisation name (PDF documents).
PDF_ORG_NAME=
PDF_APP_BASE_URL=https://arkitektur.example.org
PDF_RESPONSIBLE=Enterprise Architect
PDF_DEPARTMENT=IT
PDF_DOCUMENT_CATEGORY=Rutiner

# ── Integration Platform (optional) ───────────────────────────────────────────
# Where the platform's API is, as seen from the api container. Empty = the
# platform features are switched off and say so. With
# deploy/integration-platform.yml it defaults to
# http://integration-platform:8000/api/v1.
INTEGRATION_PLATFORM_URL=
# The consumer key the portal READS with (flowcharts, sync profiles).
INTEGRATION_PLATFORM_API_KEY=
# The platform's admin key, for RUNNING a pipeline ("Fetch now"). Empty = that
# button answers 503 with an explanation.
INTEGRATION_PLATFORM_ADMIN_KEY=
# Shared with the platform's POST_EXEC_WEBHOOK_SECRET; its "after execution"
# webhook must send it to start a sync. Empty = the webhook is switched off.
# Generate with:  openssl rand -hex 32
SYNC_WEBHOOK_SECRET=

# ── Local development only (npm run dev) ──────────────────────────────────────
# In Docker, nginx proxies /api and /config.js carries the Entra settings.
VITE_API_BASE_URL=
# VITE_ENTRA_TENANT_ID=
# VITE_ENTRA_CLIENT_ID=
# VITE_ENTRA_API_SCOPE=
